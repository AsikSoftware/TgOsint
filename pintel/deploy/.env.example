# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
POSTGRES_PASSWORD=придумайте-длинный-пароль
PINTEL_SECRET_KEY=придумайте-длинную-случайную-строку
# адрес, по которому кассы, киоски и QR на телефоне клиента видят сервер
# (с https, если включён caddy). ВАЖНО: берём поддомен, а не голый pintelkz.com,
# чтобы не перебить сайт, который уже работает на основном домене.
PINTEL_PUBLIC_URL=https://kiosk.pintelkz.com
DOMAIN=kiosk.pintelkz.com
PINTEL_SICKW_KEY=ВАШ-КЛЮЧ-SICKW
PINTEL_SICKW_SERVICES=61
PINTEL_PRICE_SHEET_URL=https://docs.google.com/spreadsheets/d/1TJWXvVC9eBFhKW38mfRBUvOftSUrWL_LmzsR-VlF-ZA/edit?gid=1917713663
PINTEL_TZ=Asia/Almaty
PINTEL_CURRENCY=₸
PINTEL_KIOSK_RETURN_SECONDS=60
PINTEL_APPLE_HISTORY_SECONDS=90

# Сколько дней держать СЫРОЙ слепок телефона внутри оценки. Сама оценка — паспорт,
# батарея, вердикт, чек, результат теста — остаётся навсегда; слепок весит около мегабайта
# на аппарат, и при двух сотнях оценок в день база росла бы на 6 ГБ в месяц. Разбор по
# слепку нужен первые недели, дальше от аппарата остаётся обезличенный эталон.
# Чистится при старте сервера и командой `python -m pintel_server.cli prune`. 0 — не чистить.
PINTEL_SNAPSHOT_KEEP_DAYS=180

# Куда клиент грузит фото/видео. В Docker — том; при установке на хост — путь на диске.
PINTEL_MEDIA_DIR=/home/www/pintel_media

# --- Импорт сделок в Pintel Оценку (ТЕСТОВЫЙ контур) ---
# Пусто = импорт выключен. Пишем в тестовую базу Оценки на этом же сервере.
# Значения берутся из .env Оценки (DB_USER/DB_PASS, TOKEN_DEMO, CHANNEL_DEMO).
PINTEL_OCENKA_DB_URL=postgresql+psycopg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@127.0.0.1:5432/pintel_ocenka_test
PINTEL_OCENKA_BOT_TOKEN=ТОКЕН-ТЕСТОВОГО-БОТА-TOKEN_DEMO
PINTEL_OCENKA_MEDIA_CHAT=ID-ЧАТА-ХРАНИЛИЩА-ДЛЯ-ФОТО
PINTEL_OCENKA_SHOP_LITERA=ЛИТЕРА-ДЕМО-ТОЧКИ
PINTEL_OCENKA_STATUS_ID=2
