# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
POSTGRES_PASSWORD=придумайте-длинный-пароль
PINTEL_SECRET_KEY=придумайте-длинную-случайную-строку
# адрес, по которому кассы и киоски видят сервер (с https, если включён caddy)
PINTEL_PUBLIC_URL=https://pintel.example.kz
DOMAIN=pintel.example.kz
PINTEL_SICKW_KEY=ВАШ-КЛЮЧ-SICKW
PINTEL_SICKW_SERVICES=61
PINTEL_PRICE_SHEET_URL=https://docs.google.com/spreadsheets/d/1TJWXvVC9eBFhKW38mfRBUvOftSUrWL_LmzsR-VlF-ZA/edit?gid=1917713663
PINTEL_TZ=Asia/Almaty
PINTEL_CURRENCY=₸
PINTEL_KIOSK_RETURN_SECONDS=60
PINTEL_APPLE_HISTORY_SECONDS=90
